# ==============================================================================
# DEEPALI AYURVEDA — SUPABASE CLIENT CONFIGURATION
# ==============================================================================
# In Vite, client-side exposed environment variables must be prefixed with VITE_
#
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to: .env.local
# 2. Log in to your Supabase Dashboard: https://supabase.com/dashboard
# 3. Open your project -> Navigate to Project Settings -> API
# 4. Copy your "Project URL" and paste it as VITE_SUPABASE_URL below
# 5. Under "Project API keys", copy your "anon" (public) key and paste it as VITE_SUPABASE_ANON_KEY below
#
# SECURITY WARNING:
# - NEVER put your "service_role" secret key or database password in this file.
# - The anon/publishable key is safe for the browser when paired with Row Level Security (RLS).
# ==============================================================================

# Supabase Project URL
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
